# Пример переменных окружения. Скопируйте в .env (он в .gitignore) и поменяйте при необходимости.
# Все переменные необязательны: значения по умолчанию заданы в src/diamonds_mlops/config.py.

# Корень проекта: относительные пути ниже считаются от него
# DIAMONDS_PROJECT_ROOT=/app

# Данные и артефакты (относительно DIAMONDS_PROJECT_ROOT или абсолютные пути)
DIAMONDS_RAW_DATA_FILE=data/raw/diamonds.csv
DIAMONDS_PROCESSED_DIR_NAME=data/processed
DIAMONDS_MODEL_FILE=models/diamond_price_model.joblib
DIAMONDS_METRICS_FILE=models/metrics.json
DIAMONDS_BASELINE_FILE=reports/monitoring/baseline.json
DIAMONDS_FIGURES_DIR_NAME=reports/figures

# Данные
DIAMONDS_RANDOM_STATE=42
DIAMONDS_TEST_SIZE=0.2
DIAMONDS_SAMPLE_ROWS=500

# Гиперпараметры RandomForestRegressor
DIAMONDS_N_ESTIMATORS=120
DIAMONDS_MIN_SAMPLES_LEAF=2
DIAMONDS_N_JOBS=-1

# Пороги мониторинга
DIAMONDS_DRIFT_THRESHOLD=0.25
DIAMONDS_RMSE_DEGRADATION_THRESHOLD=0.15
DIAMONDS_R2_DROP_THRESHOLD=0.10

# Логирование: DEBUG, INFO, WARNING, ERROR
DIAMONDS_LOG_LEVEL=INFO
